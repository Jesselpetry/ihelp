# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dropzone staging — contents are transient, see docs/DROPZONE_SOP.md
/_dropzone/*
!/_dropzone/.gitkeep
!/_dropzone/README.md

# compression audit trail, regenerated by scripts/compress-assets.sh
.compress-report.tsv

# Library assets — ~908 MB of course PDFs. They live in the public
# `ihelp-library` Supabase Storage bucket and are served from there via
# lib/asset-url.ts. Committing them pushed the git pack to 881 MB and the
# Vercel build output past 1 GB, which ran the build container out of disk.
# Keep them here locally so scripts/build-library-{manifest,stats} can scan
# them, and run `npm run assets:sync` after adding any.
/public/assets/
