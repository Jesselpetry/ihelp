# GitHub OAuth App credentials for the "push to GitHub" feature.
# Create one at https://github.com/settings/developers (New OAuth App) with:
#   Authorization callback URL: <your-app-url>/api/github/callback
#   (add http://localhost:3000/api/github/callback for local development)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Public base URL used to build the OAuth redirect_uri. Must match the
# callback URL registered on the OAuth App. Optional in local dev (falls back
# to the request origin), required behind a proxy / in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# The database is SHARED with the itgg-2026 app (same Supabase project). iHelp
# owns the `ihelp` PostgreSQL schema and never touches `itgg_2026` or `public`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — bypasses RLS. Server-only. It signs short-lived URLs for the two
# private exam buckets, `ihelp-exams` (the /exams page) and `ihelp-library-exams`
# (past papers in the course library), through lib/storage/signed-url.ts, the one
# module allowed to import the admin client. The storage scripts read it too
# (`bun run assets:sync`, `bun run library:audit -- --remote`).
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection for Drizzle (Supabase Supavisor session pooler,
# port 5432). Connects as the `postgres` role, which BYPASSES row level
# security — server code must do its own authorization checks.
DATABASE_URL=

# Salt for the footer visitor counter. The counter stores a salted, daily
# rotating SHA-256 of IP + user agent - never the IP itself. Without a salt the
# hash is brute-forceable, so lib/analytics.ts throws instead of degrading.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ANALYTICS_SALT=

# Community uploads (/upload, the "แชร์" button, and the createResource server
# action) are OFF by DEFAULT, so a production build needs no configuration to
# keep accepting no new files. Set to "1" to turn the share flow back on.
NEXT_PUBLIC_UPLOADS_ENABLED=0

# --- Optional ---------------------------------------------------------------
# Everything below is commented out: the defaults are right unless you have a
# reason to change one.

# Public origin of the site. Used for the metadata base, og:url, robots.txt and
# the sitemap (lib/site.ts). Defaults to https://ihelp.chatan.in.th, so set it
# only for a fork or a preview served from another origin. Not the same as
# NEXT_PUBLIC_APP_URL above, which is the GitHub OAuth callback origin.
# NEXT_PUBLIC_SITE_URL=

# --- Dev-only content overrides ---------------------------------------------
# Let `bun run dev` read content from a folder outside this repo, such as a
# working copy of the notes. Every one is read only when NODE_ENV is not
# "production": a build compiles the override away, so setting one on Vercel
# does nothing (lib/courses/it-kmitl.ts explains why). Unset means the bundled
# copy. Use absolute paths. The ones marked "ignored if missing" fall back to
# the bundled copy when the path does not exist; the others are taken as written.

# Replaces content/courses/ — every course's summary.md and archive/ pages.
# COURSE_CONTENT_PATH=
# Replaces data/en-kmitl/ (Computer Programming notes). Ignored if missing.
# EN_KMITL_PATH=
# Replaces data/en-kmitl/chem/ (General Chemistry). Ignored if missing.
# CHEM_PATH=
# Replace data/it-kmitl/ics/, data/it-kmitl/mfit/ and data/it-kmitl/itf/.
# Each is ignored if missing.
# ICS_PATH=
# MFIT_PATH=
# ITF_PATH=
# Replaces data/ai-guidelines/ (the AI-Guidelines-PSCP book on /library).
# AI_GUIDELINES_PATH=
# Replaces data/recommended/ (the recommended PSCP problems). Ignored if missing.
# RECOMMENDED_PATH=
# Replaces the single file data/oj_problems.json (the iJudge master problem list).
# OJ_PROBLEMS_PATH=
# Replaces the single file data/pscp/problems.json (the registry that
# `bun run pscp:build` writes).
# PSCP_REGISTRY_PATH=

# --- PSCP archive (scripts only) --------------------------------------------
# Read by `bun run pscp:registry` and `bun run pscp:verify`
# (scripts/build_pscp_registry.py, scripts/verify_solutions.py), never by the
# Next.js app. The problems and their reference solutions live in a separate
# archive repo; these say where its checkout is. Both scripts are Python and read
# the shell environment only — they do not load .env.local — so export the
# variable or prefix the command: PSCP_OP_ROOT=/path/to/.op bun run pscp:registry

# Root of the archive repo's main branch. Defaults to
# <the folder above this repo>/Y1-S1/PSCP/pscp-69070027.
# PSCP_ARCHIVE_REPO=
# The archive's OP branch, checked out as a worktree (`git worktree add .op OP`).
# Defaults to <PSCP_ARCHIVE_REPO>/.op.
# PSCP_OP_ROOT=
# The same worktree, named explicitly; wins over PSCP_OP_ROOT when both are set.
# PSCP_ARCHIVE=

# --- iJudge credentials: no longer used here --------------------------------
# IJUDGE_COOKIE, IJUDGE_USER and IJUDGE_PASS belonged to
# scripts/sync_oj_problems.py, which was folded into the archive repo's scraper
# (see CHANGELOG.md) and is gone from this repo. Nothing here reads them, so
# they are not listed: a blank IJUDGE_PASS line only invites pasting a password
# into a file nothing uses. If you still run that scraper, configure it in the
# archive repo.
