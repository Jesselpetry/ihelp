{
  "name": "ihelp",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "library:stats": "node scripts/build-library-stats.mjs",
    "library:manifest": "node scripts/build-library-manifest.mjs",
    "library:build": "bun run library:manifest && bun run library:stats",
    "assets:compress": "./scripts/compress-assets.sh",
    "content:check": "tsx scripts/validate-content.ts",
    "readiness": "tsx scripts/readiness.ts",
    "prebuild": "bun run content:check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "assets:sync": "tsx scripts/sync-library-assets.ts",
    "pscp:registry": "python3 scripts/build_pscp_registry.py",
    "pscp:edges": "python3 scripts/build_pscp_edge_cases.py",
    "pscp:build": "bun run pscp:registry && bun run pscp:edges && bun run pscp:verify",
    "compro:labs": "python3 scripts/build_compro_labs.py",
    "pscp:verify": "python3 scripts/verify_solutions.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.18.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pyodide": "^0.27.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
