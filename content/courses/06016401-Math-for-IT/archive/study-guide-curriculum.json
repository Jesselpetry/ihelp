      "title_th": "ปริพันธ์ ภาค 2",
      "title_en": "Integration (II)",
      "source_slide": "MFIT_Lec_Calculus-06",
      "pillar": "Integration Mechanics",
      "topics": [
        "Integration by substitution (u-substitution)",
        "Change of limits for definite integrals",
        "Back-substitution for leftover x",
        "Even and odd functions on symmetric intervals",
        "Integrals of absolute value functions",
        "Displacement vs total distance",
        "Trapezoidal Rule",
        "Simpson's Rule"
      ],
      "key_formulas": [
        {
          "name": "u-Substitution",
          "latex": "\\int f(g(x))g'(x)dx=\\int f(u)du,\\; u=g(x)"
        },
        {
          "name": "Definite u-substitution",
          "latex": "\\int_{a}^{b}f(g(x))g'(x)dx=\\int_{g(a)}^{g(b)}f(u)du"
        },
        {
          "name": "Log pattern",
          "latex": "\\int\\frac{u'}{u}dx=\\ln|u|+C"
        },
        {
          "name": "Odd function",
          "latex": "\\int_{-a}^{a}f_{odd}(x)dx=0"
        },
        {
          "name": "Even function",
          "latex": "\\int_{-a}^{a}f_{even}(x)dx=2\\int_{0}^{a}f(x)dx"
        },
        {
          "name": "Displacement",
          "latex": "\\int_{a}^{b}v(t)dt"
        },
        {
          "name": "Total distance",
          "latex": "\\int_{a}^{b}|v(t)|dt"
        },
        {
          "name": "Trapezoidal Rule",
          "latex": "\\int_a^b f\\,dx\\approx\\frac{b-a}{2n}\\left[f(x_0)+2f(x_1)+\\cdots+2f(x_{n-1})+f(x_n)\\right]"
        }
      ],
      "solution_patterns": [
        "6-step u-substitution",
        "Change-of-limits table for definite integrals",
        "5-step absolute value split",
        "Sign chart of v(t) for total distance"
      ],
      "pitfalls": [
        "Leaving x in the integrand after substituting u",
        "Using the original limits with the new variable u",
        "Forgetting to substitute u back to x",
        "Not splitting the interval for an absolute value integrand",
        "Flipping the piecewise cases for an absolute value",
        "Getting a negative answer for an absolute value integral",
        "Believing (-1)^{2/5} is undefined",
        "Omitting + C",
        "Using the even/odd shortcut without showing work"
      ],
