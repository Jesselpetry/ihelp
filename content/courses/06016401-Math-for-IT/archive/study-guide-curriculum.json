        {
          "name": "Limit of a radical",
          "latex": "\\lim_{x\\to c}\\sqrt[n]{x}=\\sqrt[n]{c}"
        },
        {
          "name": "Quotient law",
          "latex": "\\lim_{x\\to c}\\frac{f(x)}{g(x)}=\\frac{\\lim f}{\\lim g},\\;\\lim g\\neq 0"
        },
        {
          "name": "Two-sided existence",
          "latex": "\\lim_{x\\to c}f(x)=L \\iff \\lim_{x\\to c^-}f(x)=\\lim_{x\\to c^+}f(x)=L"
        },
        {
          "name": "Special trig limit",
          "latex": "\\lim_{x\\to 0}\\frac{\\sin x}{x}=1"
        },
        {
          "name": "Limit at infinity",
          "latex": "\\lim_{x\\to\\pm\\infty}\\frac{1}{x^{n}}=0"
        },
        {
          "name": "Continuity at c",
          "latex": "f(c)\\text{ defined},\\; \\lim_{x\\to c}f(x)\\text{ exists},\\; \\lim_{x\\to c}f(x)=f(c)"
        },
        {
          "name": "Conjugate identity",
          "latex": "(\\sqrt{a}-b)(\\sqrt{a}+b)=a-b^{2}"
        }
      ],
