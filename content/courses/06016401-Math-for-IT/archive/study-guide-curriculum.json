      "source_slide": "MFIT_Lec_Calculus-07",
      "pillar": "Integration as a Tool",
      "topics": [
        "Integration by parts",
        "LIATE selection rule",
        "Tabular method",
        "Cyclic (recursive) integration by parts",
        "Area between two curves",
        "Volume of a solid of revolution",
        "Disk method",
        "Washer method",
        "Shell method"
      ],
      "key_formulas": [
        {
          "name": "Integration by parts",
          "latex": "\\int u\\,dv=uv-\\int v\\,du"
        },
        {
          "name": "LIATE order",
          "latex": "\\text{Log} \\to \\text{Inverse trig} \\to \\text{Algebraic} \\to \\text{Trig} \\to \\text{Exponential}"
        },
        {
          "name": "Integral of ln",
          "latex": "\\int\\ln x\\,dx=x\\ln x-x+C"
        },
        {
          "name": "Cyclic result",
          "latex": "\\int e^{x}\\sin x\\,dx=\\frac{e^{x}(\\sin x-\\cos x)}{2}+C"
        },
        {
          "name": "Area between curves",
          "latex": "A=\\int_{a}^{b}\\left[f_{top}(x)-f_{bottom}(x)\\right]dx"
        },
        {
          "name": "Disk method",
          "latex": "V=\\pi\\int_{a}^{b}[R(x)]^{2}dx"
        },
        {
          "name": "Washer method",
          "latex": "V=\\pi\\int_{a}^{b}\\left([R]^{2}-[r]^{2}\\right)dx"
        },
        {
          "name": "Shell method",
          "latex": "V=2\\pi\\int_{a}^{b}(\\text{radius})(\\text{height})\\,dx"
        }
      ],
      "solution_patterns": [
        "5-step integration by parts with a 4-cell table",
        "Tabular method for polynomial times sin/cos/exp",
        "Set I = integral and solve algebraically for the cyclic case",
        "5-step area between curves (sketch, intersect, order, integrate, split if needed)",
        "Expand the squared radius before integrating"
      ],
      "pitfalls": [
        "Choosing u against LIATE and making the integral harder",
        "Using + instead of - in the by-parts formula",
        "Wrong alternating signs or non-diagonal reading in the tabular method",
        "Switching the u type on the second cyclic pass",
        "Omitting + C after dividing by 2 in the cyclic case",
        "Writing [R-r]^2 instead of [R]^2-[r]^2",
        "Omitting pi or the square in the disk formula",
        "Not expanding [(x-1)^2+1]^2 before integrating",
        "Not sketching and swapping top/bottom curves",
        "Omitting units"
      ],
