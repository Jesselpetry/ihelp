      "source_slide": "MFIT_Lec_Calculus-08",
      "pillar": "Integration as a Tool",
      "topics": [
        "Moments",
        "Center of mass of a discrete system",
        "Centroid of a planar lamina",
        "Constant density and cancellation of rho",
        "Symmetry shortcut",
        "Theorem of Pappus",
        "Functions of two or more variables",
        "Partial derivatives",
        "Higher-order partial derivatives",
        "Clairaut's theorem"
      ],
      "key_formulas": [
        {
          "name": "Moment",
          "latex": "M=m\\cdot d"
        },
        {
          "name": "Discrete moments",
          "latex": "M_{y}=\\sum m_{i}x_{i},\\quad M_{x}=\\sum m_{i}y_{i}"
        },
        {
          "name": "Center of mass",
          "latex": "\\bar{x}=\\frac{M_{y}}{m},\\quad \\bar{y}=\\frac{M_{x}}{m}"
        },
        {
          "name": "Lamina area",
          "latex": "A=\\int_{a}^{b}[f(x)-g(x)]dx"
        },
        {
          "name": "Centroid x",
          "latex": "\\bar{x}=\\frac{1}{A}\\int_{a}^{b}x[f(x)-g(x)]dx"
        },
        {
          "name": "Centroid y",
          "latex": "\\bar{y}=\\frac{1}{2A}\\int_{a}^{b}\\left([f(x)]^{2}-[g(x)]^{2}\\right)dx"
        },
        {
          "name": "Theorem of Pappus",
          "latex": "V=2\\pi\\bar{r}A"
        },
        {
          "name": "Partial derivative",
          "latex": "f_{x}=\\frac{\\partial f}{\\partial x}\\;(\\text{treat }y\\text{ as constant})"
        },
        {
          "name": "Clairaut",
          "latex": "f_{xy}=f_{yx}\\;(\\text{when continuous})"
        }
      ],
      "solution_patterns": [
        "4-step centroid computation (A, M_y, M_x, divide)",
        "Use symmetry to short-circuit one coordinate",
        "Hold the other variable constant for partial derivatives",
        "Differentiate first, substitute the point last"
      ],
      "pitfalls": [
        "Swapping M_x and M_y",
        "Omitting the average (f+g)/2 in the y-bar formula",
        "Writing (f-g)^2 instead of f^2-g^2",
        "Differentiating the held-constant variable",
        "Substituting the point before differentiating",
        "Forgetting that rho cancels",
        "Reporting a centroid as a single number instead of a coordinate pair"
      ],
